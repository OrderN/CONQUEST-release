IO.Title    Bulk Fe diagon SCF calculation
IO.Coordinates    coord_Fe-bcc_exptl_AF.in
IO.FractionalAtomicCoords T
IO.Iprint 2

## General Parameters
General.NumberOfSpecies 2

## Moving Atoms
AtomMove.TypeOfRun static

## Spin
Spin.SpinPolarised T
Spin.FixSpin  F
Spin.Magn  0.0
Spin.NeUP 16.0
Spin.NeDN 16.0

## DOS
# Ef is around -0.3 Ha
IO.WFRangeRelative F
IO.min_wf_E -0.800   # 0.450 (Ha) = 12.245 eV
IO.max_wf_E  0.200

IO.writeDOS T
IO.write_proj_DOS T

Process.Job pdos
Process.WFRangeRelative T
Process.min_DOS_E -0.450   # (Ha) = 12.245 eV
Process.max_DOS_E  0.450
Process.sigma_DOS 0.005     # (Ha, default 0.001)
Process.n_DOS     3601      # (default 1001)
Process.pDOS_l_resolved T
#Process.pDOS_lm_resolved T


## Basis Sets
Basis.BasisSet PAOs

## Energy Minimisation
minE.SelfConsistent T
minE.SCTolerance 1.0e-6
SC.LinearMixingFactor 0.2
SC.MaxIters  100

##Integration Grid
Grid.GridCutoff 200

## Finding Density Matrix
DM.SolutionMethod diagon
Diag.kT   0.002
Diag.MPMesh T
Diag.MPMeshX 12
Diag.MPMeshY 12
Diag.MPMeshZ 12

## Atomic Information
%block ChemicalSpeciesLabel
1       55.845          Fe1
2       55.845          Fe2
%endblock ChemicalSpeciesLabel

%block Fe1
Atom.SpinNeUp 9.00
Atom.SpinNeDn 7.00
%endblock Fe1

%block Fe2
Atom.SpinNeUp 7.00
Atom.SpinNeDn 9.00
%endblock Fe2



